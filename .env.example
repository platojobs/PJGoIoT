# 复制为 .env 后按需修改；不要提交真实密码。
# 本地默认使用 localhost + Caddy 自签证书。
DOMAIN=localhost

# 数据库凭据（生产必须改；建议 openssl rand -hex 24）
POSTGRES_USER=pjgoiot
POSTGRES_PASSWORD=pjgoiot-local-only
POSTGRES_DB=pjgoiot

# 仅绑定本机回环的数据库端口
POSTGRES_PORT=55432

# 服务版本（与 OpenAPI 契约版本不是同一个号，见 README）
APP_VERSION=0.24.0

# 启动时自动迁移；失败则进程退出
RUN_MIGRATIONS_ON_BOOT=true

# 应用限流
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_BURST=40
PAIRING_CLAIM_RATE_PER_MINUTE=20
PAIRING_CLAIM_BURST=10
# 反馈接口双维度限流：账号与 IP 同时生效，超限返回 429 FEEDBACK_RATE_LIMITED
FEEDBACK_USER_RATE_PER_MINUTE=10
FEEDBACK_USER_BURST=5
FEEDBACK_IP_RATE_PER_MINUTE=30
FEEDBACK_IP_BURST=10
# 运营侧受理入口凭据（请求头 X-Admin-Token）；留空则 /admin/feedback 整组返回 404。
# 生产建议：ADMIN_TOKEN=$(openssl rand -hex 32)，只下发给内部工具，不要进客户端。
ADMIN_TOKEN=
# 密钥轮换（可选）：窗口内新旧两把同时有效，窗口结束后上一把自动 401。
# ADMIN_TOKEN_PREVIOUS=<old-key>
# ADMIN_TOKEN_ROTATED_AT=2026-11-07T08:00:00Z
# ADMIN_TOKEN_ROTATION_WINDOW_SECONDS=86400
CORS_ALLOWED_ORIGINS=*
LOG_LEVEL=info

# /metrics 只允许内网访问（Caddy 已显式拒绝公网访问该路径）
METRICS_ENABLED=true

# token 有效期（天）；过期后鉴权 401，cleanup 负责物理删除
TOKEN_TTL_DAYS=180

# 保留期（cleanup 服务）
READING_RETENTION_DAYS=90
CHANGE_LOG_RETENTION_DAYS=90
IDEMPOTENCY_RETENTION_DAYS=7
